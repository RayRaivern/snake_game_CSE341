DRAW_SCORE PROC NEAR
	PUSH AX
	PUSH BX
	PUSH CX
	PUSH DX
	PUSH SI

	MOV AX, score
	MOV BX, 10

	;3rd digit
	XOR DX, DX
	DIV BX
	ADD DL, '0'
	MOV score_str[2], DL
	;2nd digit
	XOR DX, DX
	DIV BX
	ADD DL, '0'
	MOV score_str[1], DL
	;1st digit
	XOR DX, DX
	DIV BX
	ADD DL, '0'
	MOV score_str[0], DL

	;print score
	MOV DH, 0
	MOV DL, 5
	MOV AL, 'S'
	MOV BL, COLOR_BORDER
	CALL WRITE_CHAR_AT
	MOV DL, 6
	MOV AL, 'C'
	MOV BL, COLOR_BORDER
	CALL WRITE_CHAR_AT
	MOV DL, 7
	MOV AL, 'O'
	MOV BL, COLOR_BORDER
	CALL WRITE_CHAR_AT
	MOV DL, 8
	MOV AL, 'R'
	MOV BL, COLOR_BORDER
	CALL WRITE_CHAR_AT
	MOV DL, 9
	MOV AL, 'E'
	MOV BL, COLOR_BORDER
	CALL WRITE_CHAR_AT
	
	MOV SI, 0
	MOV CX, 3
	PRINT_SCORE_LOOP:
		MOV AX, SI
	    ADD AL, 12
	    MOV DL, AL
	    MOV DH, 0

		MOV AL, score_str[SI]
		MOV BL, COLOR_HEAD
		CALL WRITE_CHAR_AT
		INC SI
		LOOP PRINT_SCORE_LOOP

	POP AX
	POP BX
	POP CX
	POP DX
	POP SI

	RET


DRAW_SCORE ENDP